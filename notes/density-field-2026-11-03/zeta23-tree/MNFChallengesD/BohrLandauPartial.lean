/-- The same with the lower threshold `σ₁` as a separate binder (at `σ = 1` again only
vacuously; see `meanSquare_strip_of`). -/
theorem meanSquare_strip_from {σ₁ σ : ℝ} (h0 : 2 / 3 ≤ σ₁) (h1 : σ₁ ≤ σ) (h2 : σ ≤ 1) :
