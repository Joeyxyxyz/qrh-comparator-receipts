          - (⌈T⌉₊ : ℂ) ^ (1 - ((σ : ℂ) + t * I)) / (((σ : ℂ) + t * I) - 1)‖
        ≤ C * (⌈T⌉₊ : ℝ) ^ (-σ) := by
  sorry

/-- The same with the error bounded by the constant alone (N^{−σ} ≤ 1 since N ≥ 1, σ ≥ 0) and with
C ≥ 0, as `norm_zeta_sq_le_sharp` uses it: ζ = S_N + N^{1−s}/(s−1) + E with ‖E‖ ≤ C on the whole
segment. -/
theorem zeta_approx_sharp_segment' {σ₁ : ℝ} (h1 : 1 / 2 < σ₁) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ σ : ℝ, σ₁ ≤ σ → σ ≤ 2 → ∀ T : ℝ, 2 ≤ T → ∀ t ∈ Icc (1 : ℝ) T,
      ‖riemannZeta ((σ : ℂ) + t * I) - S ⌈T⌉₊ ((σ : ℂ) + t * I)
          - (⌈T⌉₊ : ℂ) ^ (1 - ((σ : ℂ) + t * I)) / (((σ : ℂ) + t * I) - 1)‖
        ≤ C := by
  sorry

