          - (N : ℂ) ^ (1 - ((σ : ℂ) + t * I)) / (((σ : ℂ) + t * I) - 1)‖
        ≤ C * (N : ℝ) ^ (-σ) := by
  sorry

/-! ### The segment specialisation: t ∈ [1, T], N = ⌈T⌉₊ -/

/-- For σ₁ > 1/2, T ≥ 2 and N := ⌈T⌉₊, every t ∈ [1, T] satisfies t ≤ N and s = σ + it ≠ 1, so
