@moebius_sq : ∀ {n : ℕ}, μ n ^ 2 = if Squarefree n then 1 else 0
sigma_zero_apply : ∀ (n : ℕ), (σ 0) n = n.divisors.card
@sigma_zero_apply_prime_pow : ∀ {p i : ℕ}, Nat.Prime p → (σ 0) (p ^ i) = i + 1
