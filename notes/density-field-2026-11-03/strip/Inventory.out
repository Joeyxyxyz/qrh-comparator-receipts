Nat.card_divisors_le_self : ∀ (n : ℕ), n.divisors.card ≤ n
@Nat.Coprime.card_divisors_mul : ∀ {m n : ℕ}, m.Coprime n → (m * n).divisors.card = m.divisors.card * n.divisors.card
@Nat.sum_divisorsAntidiagonal : ∀ {M : Type u_1} [inst : AddCommMonoid M] (f : ℕ → ℕ → M) {n : ℕ},
  ∑ i ∈ n.divisorsAntidiagonal, f i.1 i.2 = ∑ i ∈ n.divisors, f i (n / i)
@Nat.sum_divisorsAntidiagonal' : ∀ {M : Type u_1} [inst : AddCommMonoid M] (f : ℕ → ℕ → M) {n : ℕ},
  ∑ i ∈ n.divisorsAntidiagonal, f i.1 i.2 = ∑ i ∈ n.divisors, f (n / i) i
@Nat.mem_divisorsAntidiagonal : ∀ {n : ℕ} {x : ℕ × ℕ}, x ∈ n.divisorsAntidiagonal ↔ x.1 * x.2 = n ∧ n ≠ 0
@Nat.mem_divisors : ∀ {n m : ℕ}, n ∈ m.divisors ↔ n ∣ m ∧ m ≠ 0
@Nat.sum_divisors_eq_sum_properDivisors_add_self : ∀ {n : ℕ}, ∑ i ∈ n.divisors, i = ∑ i ∈ n.properDivisors, i + n
Nat.divisors_mul : ∀ (m n : ℕ), (m * n).divisors = m.divisors * n.divisors
@Finset.nat_divisors_prod : ∀ {ι : Type u_1} (s : Finset ι) (f : ι → ℕ),
  (∏ i ∈ s, f i).divisors = ∏ i ∈ s, (f i).divisors
@harmonic_eq_sum_Icc : ∀ {n : ℕ}, harmonic n = ∑ i ∈ Finset.Icc 1 n, (↑i)⁻¹
harmonic_le_one_add_log : ∀ (n : ℕ), ↑(harmonic n) ≤ 1 + Real.log ↑n
log_add_one_le_harmonic : ∀ (n : ℕ), Real.log ↑(n + 1) ≤ ↑(harmonic n)
harmonic_floor_le_one_add_log : ∀ (y : ℝ), 1 ≤ y → ↑(harmonic ⌊y⌋₊) ≤ 1 + Real.log y
@LSeries_zeta_mul_Lseries_moebius : ∀ {s : ℂ}, 1 < s.re → L (fun n => ↑(ζ n)) s * L (fun n => ↑(μ n)) s = 1
@LSeries_zeta_eq_riemannZeta : ∀ {s : ℂ}, 1 < s.re → L (fun n => ↑(ζ n)) s = riemannZeta s
@LSeries_convolution' : ∀ {f g : ℕ → ℂ} {s : ℂ}, LSeriesSummable f s → LSeriesSummable g s → L (f ⍟ g) s = L f s * L g s
@LSeries_mul' : ∀ {f g : ArithmeticFunction ℂ} {s : ℂ},
  LSeriesSummable (fun n => f n) s →
    LSeriesSummable (fun n => g n) s → L (fun n => (f * g) n) s = L (fun n => f n) s * L (fun n => g n) s
@LSeries.convolution_def : ∀ {R : Type u_1} [inst : Semiring R] (f g : ℕ → R),
  f ⍟ g = fun n => ∑ p ∈ n.divisorsAntidiagonal, f p.1 * g p.2
@LSeriesSummable_moebius_iff : ∀ {s : ℂ}, LSeriesSummable (fun n => ↑(μ n)) s ↔ 1 < s.re
@sum_mul_eq_sub_sub_integral_mul : ∀ {𝕜 : Type u_1} [inst : RCLike 𝕜] (c : ℕ → 𝕜) {f : ℝ → 𝕜} {a b : ℝ},
  0 ≤ a →
    a ≤ b →
      (∀ t ∈ Set.Icc a b, DifferentiableAt ℝ f t) →
        MeasureTheory.IntegrableOn (deriv f) (Set.Icc a b) MeasureTheory.volume →
          ∑ k ∈ Finset.Ioc ⌊a⌋₊ ⌊b⌋₊, f ↑k * c k =
            f b * ∑ k ∈ Finset.Icc 0 ⌊b⌋₊, c k - f a * ∑ k ∈ Finset.Icc 0 ⌊a⌋₊, c k -
              ∫ (t : ℝ) in Set.Ioc a b, deriv f t * ∑ k ∈ Finset.Icc 0 ⌊t⌋₊, c k
@vonMangoldt_sum : ∀ {n : ℕ}, ∑ i ∈ n.divisors, Λ i = Real.log ↑n
@sum_moebius_mul_log_eq : ∀ {n : ℕ}, ∑ d ∈ n.divisors, ↑(μ d) * log d = -Λ n
@Finset.sum_mul_sq_le_sq_mul_sq : ∀ {ι : Type u_1} {R : Type u_2} [inst : CommSemiring R] [inst_1 : LinearOrder R]
  [IsStrictOrderedRing R] [ExistsAddOfLE R] (s : Finset ι) (f g : ι → R),
  (∑ i ∈ s, f i * g i) ^ 2 ≤ (∑ i ∈ s, f i ^ 2) * ∑ i ∈ s, g i ^ 2
