@AnalyticOnNhd.circleAverage_log_norm : ∀ {c : ℂ} {R : ℝ} {f : ℂ → ℂ},
  R ≠ 0 →
    AnalyticOnNhd ℂ f (Metric.closedBall c |R|) →
      f c ≠ 0 →
        Real.circleAverage (fun x => Real.log ‖f x‖) c R =
          ∑ᶠ (u : ℂ), ↑((MeromorphicOn.divisor f (Metric.closedBall c |R|)) u) * Real.log (R * ‖c - u‖⁻¹) +
            Real.log ‖f c‖
