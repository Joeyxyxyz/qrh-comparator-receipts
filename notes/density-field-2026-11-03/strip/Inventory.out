  (↑ζ * f) x = ∑ i ∈ x.divisors, f i
@coe_mul_zeta_apply : ∀ {R : Type u_1} [inst : Semiring R] {f : ArithmeticFunction R} {x : ℕ},
  (f * ↑ζ) x = ∑ i ∈ x.divisors, f i
