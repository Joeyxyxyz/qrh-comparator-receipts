  f.IsMultiplicative → g.IsMultiplicative → (f * g).IsMultiplicative
ArithmeticFunction.isMultiplicative_moebius : μ.IsMultiplicative
ArithmeticFunction.isMultiplicative_zeta : ζ.IsMultiplicative
@isMultiplicative_sigma : ∀ {k : ℕ}, (σ k).IsMultiplicative
@sum_eq_iff_sum_mul_moebius_eq : ∀ {R : Type u_1} [inst : NonAssocRing R] {f g : ℕ → R},
  (∀ n > 0, ∑ i ∈ n.divisors, f i = g n) ↔ ∀ n > 0, ∑ x ∈ n.divisorsAntidiagonal, ↑(μ x.1) * g x.2 = f n
@sum_eq_iff_sum_smul_moebius_eq : ∀ {R : Type u_1} [inst : AddCommGroup R] {f g : ℕ → R},
  (∀ n > 0, ∑ i ∈ n.divisors, f i = g n) ↔ ∀ n > 0, ∑ x ∈ n.divisorsAntidiagonal, μ x.1 • g x.2 = f n
