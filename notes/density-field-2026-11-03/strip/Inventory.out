@MeromorphicOn.divisor_mul : ∀ {𝕜 : Type u_1} [inst : NontriviallyNormedField 𝕜] {U : Set 𝕜} {f₁ f₂ : 𝕜 → 𝕜},
  MeromorphicOn f₁ U →
    MeromorphicOn f₂ U →
      (∀ z ∈ U, meromorphicOrderAt f₁ z ≠ ⊤) →
        (∀ z ∈ U, meromorphicOrderAt f₂ z ≠ ⊤) →
          MeromorphicOn.divisor (f₁ * f₂) U = MeromorphicOn.divisor f₁ U + MeromorphicOn.divisor f₂ U
@MeromorphicOn.divisor_fun_mul : ∀ {𝕜 : Type u_1} [inst : NontriviallyNormedField 𝕜] {U : Set 𝕜} {f₁ f₂ : 𝕜 → 𝕜},
  MeromorphicOn f₁ U →
    MeromorphicOn f₂ U →
      (∀ z ∈ U, meromorphicOrderAt f₁ z ≠ ⊤) →
        (∀ z ∈ U, meromorphicOrderAt f₂ z ≠ ⊤) →
          MeromorphicOn.divisor (fun z => f₁ z * f₂ z) U = MeromorphicOn.divisor f₁ U + MeromorphicOn.divisor f₂ U
@analyticOrderAt_mul : ∀ {𝕜 : Type u_1} [inst : NontriviallyNormedField 𝕜] {f g : 𝕜 → 𝕜} {z₀ : 𝕜},
  AnalyticAt 𝕜 f z₀ → AnalyticAt 𝕜 g z₀ → analyticOrderAt (f * g) z₀ = analyticOrderAt f z₀ + analyticOrderAt g z₀
@MeromorphicOn.AnalyticOnNhd.divisor_apply : ∀ {𝕜 : Type u_1} [inst : NontriviallyNormedField 𝕜] {U : Set 𝕜} {z : 𝕜}
  {E : Type u_2} [inst_1 : NormedAddCommGroup E] [inst_2 : NormedSpace 𝕜 E] {f : 𝕜 → E},
  AnalyticOnNhd 𝕜 f U → z ∈ U → (MeromorphicOn.divisor f U) z = (ENat.map Nat.cast (analyticOrderAt f z)).untop₀
