@BLClosure.first_derivative_test_amp_smooth' : ∀ {a b lam : ℝ},
  a ≤ b →
    0 < lam →
      ∀ (F F' F'' : ℝ → ℝ),
        (∀ x ∈ Set.Icc a b, HasDerivAt F (F' x) x) →
          (∀ x ∈ Set.Icc a b, HasDerivAt F' (F'' x) x) →
            (∀ x ∈ Set.Icc a b, lam ≤ F' x) →
              ContinuousOn F'' (Set.Icc a b) →
                ∀ (G G' : ℝ → ℝ),
                  (∀ x ∈ Set.Icc a b, HasDerivAt G (G' x) x) →
                    (∀ x ∈ Set.Icc a b, 0 ≤ G x) →
                      ContinuousOn G' (Set.Icc a b) →
                        (∀ x ∈ Set.Icc a b, G' x * F' x - G x * F'' x ≤ 0) →
                          ‖∫ (x : ℝ) in a..b, ↑(G x) * Complex.exp (Complex.I * ↑(F x))‖ ≤ 4 * G a / lam
@BLClosure.first_derivative_test_amp_smooth : ∀ {a b lam : ℝ},
  a ≤ b →
    0 < lam →
      ∀ (F F' F'' : ℝ → ℝ),
        (∀ x ∈ Set.Icc a b, HasDerivAt F (F' x) x) →
          (∀ x ∈ Set.Icc a b, HasDerivAt F' (F'' x) x) →
            (∀ x ∈ Set.Icc a b, 0 ≤ F'' x) →
              (∀ x ∈ Set.Icc a b, lam ≤ F' x) →
                ContinuousOn F'' (Set.Icc a b) →
                  ∀ (G G' : ℝ → ℝ),
                    (∀ x ∈ Set.Icc a b, HasDerivAt G (G' x) x) →
                      (∀ x ∈ Set.Icc a b, G' x ≤ 0) →
                        (∀ x ∈ Set.Icc a b, 0 ≤ G x) →
                          ContinuousOn G' (Set.Icc a b) →
                            ‖∫ (x : ℝ) in a..b, ↑(G x) * Complex.exp (Complex.I * ↑(F x))‖ ≤ 4 * G a / lam
@BLClosure.first_derivative_test_smooth : ∀ {a b lam : ℝ},
  a ≤ b →
    0 < lam →
      ∀ (F F' F'' : ℝ → ℝ),
        (∀ x ∈ Set.Icc a b, HasDerivAt F (F' x) x) →
          (∀ x ∈ Set.Icc a b, HasDerivAt F' (F'' x) x) →
            (∀ x ∈ Set.Icc a b, 0 ≤ F'' x) →
              (∀ x ∈ Set.Icc a b, lam ≤ F' x) →
                ContinuousOn F'' (Set.Icc a b) → ‖∫ (x : ℝ) in a..b, Complex.exp (Complex.I * ↑(F x))‖ ≤ 4 / lam
BLClosure.mode_integrand_eq : ∀ (σ t : ℝ) (ν : ℕ) {u : ℝ},
  0 < u →
    Complex.exp (2 * ↑Real.pi * Complex.I * ↑ν * ↑u) * ↑u ^ (-↑σ - ↑t * Complex.I - 2) =
      ↑(u ^ (-σ - 2)) * Complex.exp (Complex.I * ↑(2 * Real.pi * ↑ν * u - t * Real.log u))
@BLClosure.mode_bound_interval : ∀ {σ t x X : ℝ},
  0 < σ →
    1 ≤ x →
      t ≤ Real.pi * x →
        x ≤ X →
          ∀ {ν : ℕ},
            1 ≤ ν →
              ‖∫ (u : ℝ) in x..X,
                    ↑(u ^ (-σ - 2)) * Complex.exp (Complex.I * ↑(2 * Real.pi * ↑ν * u - t * Real.log u))‖ ≤
                4 * x ^ (-σ - 2) / (Real.pi * ↑ν)
@BLClosure.integrableOn_bdd_mul_cpow' : ∀ {e : ℝ → ℂ},
  Measurable e →
    (∀ (u : ℝ), ‖e u‖ ≤ 1) →
      ∀ {a : ℝ},
        0 < a →
          ∀ {w : ℂ}, w.re < -1 → MeasureTheory.IntegrableOn (fun u => e u * ↑u ^ w) (Set.Ioi a) MeasureTheory.volume
@BLClosure.integrableOn_exp_mul_cpow : ∀ {α : ℂ},
  α.re = 0 →
    ∀ {a : ℝ},
      0 < a →
        ∀ {w : ℂ},
          w.re < -1 →
            MeasureTheory.IntegrableOn (fun u => Complex.exp (α * ↑u) * ↑u ^ w) (Set.Ioi a) MeasureTheory.volume
@BLClosure.integrableOn_exp_neg_mul_cpow : ∀ {α : ℂ},
  α.re = 0 →
    ∀ {a : ℝ},
      0 < a →
        ∀ {w : ℂ},
          w.re < -1 →
            MeasureTheory.IntegrableOn (fun u => Complex.exp (-(α * ↑u)) * ↑u ^ w) (Set.Ioi a) MeasureTheory.volume
BLClosure.re_w : ∀ (σ t : ℝ), (-↑σ - ↑t * Complex.I - 2).re = -σ - 2
@BLClosure.re_w_lt : ∀ {σ : ℝ}, 0 < σ → ∀ (t : ℝ), (-↑σ - ↑t * Complex.I - 2).re < -1
BLClosure.re_phase : ∀ (ν : ℕ), (2 * ↑Real.pi * Complex.I * ↑ν).re = 0
BLClosure.re_phase' : ∀ (ν : ℕ), (2 * ↑Real.pi * Complex.I * (↑ν + 1)).re = 0
@BLClosure.tail_mode_bound' : ∀ {σ t x : ℝ},
  0 < σ →
    1 ≤ x →
      t ≤ Real.pi * x →
        ∀ {ν : ℕ},
          1 ≤ ν →
            ‖∫ (u : ℝ) in Set.Ioi x,
                  Complex.exp (2 * ↑Real.pi * Complex.I * ↑ν * ↑u) * ↑u ^ (-↑σ - ↑t * Complex.I - 2)‖ ≤
              8 / (Real.pi * ↑ν) * x ^ (-σ - 2)
@BLClosure.tail_mode_bound : ∀ {σ t x : ℝ},
  0 < σ →
    1 ≤ x →
      0 ≤ t →
        t / Real.pi ≤ x →
          ∀ {ν : ℕ},
            1 ≤ ν →
              ‖∫ (u : ℝ) in Set.Ioi x,
                    Complex.exp (2 * ↑Real.pi * Complex.I * ↑ν * ↑u) * ↑u ^ (-↑σ - ↑t * Complex.I - 2)‖ ≤
                8 / (Real.pi * ↑ν) * x ^ (-σ - 2)
@BLClosure.tail_mode_bound_neg : ∀ {σ t x : ℝ},
  0 < σ →
    1 ≤ x →
      -t ≤ Real.pi * x →
        ∀ {ν : ℕ},
          1 ≤ ν →
            ‖∫ (u : ℝ) in Set.Ioi x,
                  Complex.exp (-(2 * ↑Real.pi * Complex.I * ↑ν * ↑u)) * ↑u ^ (-↑σ - ↑t * Complex.I - 2)‖ ≤
              8 / (Real.pi * ↑ν) * x ^ (-σ - 2)
BLClosure.cmode_hasSum : ∀ (u : ℝ), HasSum (fun ν => BLClosure.cmode ν u) (BLClosure.P u + 1 / 12)
BLClosure.continuous_cmode : ∀ (ν : ℕ), Continuous (BLClosure.cmode ν)
BLClosure.cmode_abs_le : ∀ (ν : ℕ) (u : ℝ), |BLClosure.cmode ν u| ≤ 1 / (2 * Real.pi ^ 2) * (1 / (↑ν + 1) ^ 2)
BLClosure.cmode_eq : ∀ (ν : ℕ) (u : ℝ),
  ↑(BLClosure.cmode ν u) =
    ↑(1 / (2 * Real.pi ^ 2 * (↑ν + 1) ^ 2) / 2) *
      (Complex.exp (2 * ↑Real.pi * Complex.I * (↑ν + 1) * ↑u) +
        Complex.exp (-(2 * ↑Real.pi * Complex.I * (↑ν + 1) * ↑u)))
@BLClosure.mode_integral_bound : ∀ {σ t : ℝ},
  0 < σ →
    ∀ {N : ℕ},
      1 ≤ N →
        t ≤ Real.pi * ↑N →
          -t ≤ Real.pi * ↑N →
            ∀ (ν : ℕ),
              ‖∫ (u : ℝ) in Set.Ioi ↑N, ↑(BLClosure.cmode ν u) * ↑u ^ (-↑σ - ↑t * Complex.I - 2)‖ ≤
                4 / Real.pi ^ 3 * (1 / (↑ν + 1) ^ 3) * ↑N ^ (-σ - 2)
@BLClosure.hasSum_mode_integrals : ∀ {σ t : ℝ},
  0 < σ →
    ∀ {N : ℕ},
      1 ≤ N →
        HasSum (fun ν => ∫ (u : ℝ) in Set.Ioi ↑N, ↑(BLClosure.cmode ν u) * ↑u ^ (-↑σ - ↑t * Complex.I - 2))
          (∫ (u : ℝ) in Set.Ioi ↑N, ↑(BLClosure.P u + 1 / 12) * ↑u ^ (-↑σ - ↑t * Complex.I - 2))
@BLClosure.split_P : ∀ {σ t : ℝ},
  0 < σ →
    ∀ {N : ℕ},
      1 ≤ N →
        ∫ (u : ℝ) in Set.Ioi ↑N, ↑(BLClosure.P u) * ↑u ^ (-↑σ - ↑t * Complex.I - 2) =
          (∫ (u : ℝ) in Set.Ioi ↑N, ↑(BLClosure.P u + 1 / 12) * ↑u ^ (-↑σ - ↑t * Complex.I - 2)) -
            1 / 12 * ∫ (u : ℝ) in Set.Ioi ↑N, ↑u ^ (-↑σ - ↑t * Complex.I - 2)
@BLClosure.integral_cpow_tail : ∀ {σ t : ℝ},
  0 < σ →
    ∀ {N : ℕ},
      1 ≤ N →
        ∫ (u : ℝ) in Set.Ioi ↑N, ↑u ^ (-↑σ - ↑t * Complex.I - 2) =
          ↑N ^ (-(↑σ + ↑t * Complex.I + 1)) / (↑σ + ↑t * Complex.I + 1)
@BLClosure.tail_sharp : ∀ {σ₀ : ℝ},
  0 < σ₀ →
    ∃ C,
      ∀ (σ t : ℝ),
        σ₀ ≤ σ →
          σ ≤ 2 →
            0 ≤ t →
              ∀ (N : ℕ),
                1 ≤ N →
                  t ≤ ↑N →
                    ‖(↑σ + ↑t * Complex.I) *
                          ∫ (u : ℝ) in Set.Ioi ↑N, ↑(BLClosure.psi u) * ↑u ^ (-(↑σ + ↑t * Complex.I) - 1)‖ ≤
                      C * ↑N ^ (-σ)
@BLClosure.zeta_eq_euler_maclaurin : ∀ {s : ℂ},
  0 < s.re →
    s ≠ 1 →
      ∀ {N : ℕ},
        1 ≤ N →
          riemannZeta s =
            BLClosure.S N s + ↑N ^ (1 - s) / (s - 1) - ↑N ^ (-s) / 2 -
              s * ∫ (u : ℝ) in Set.Ioi ↑N, ↑(BLClosure.psi u) * ↑u ^ (-s - 1)
@BLClosure.norm_natCast_cpow_neg_div_two : ∀ {σ t : ℝ} {N : ℕ},
  1 ≤ N → ‖↑N ^ (-(↑σ + ↑t * Complex.I)) / 2‖ = ↑N ^ (-σ) / 2
@BLClosure.zeta_approx_sharp : ∀ {σ₀ : ℝ},
  0 < σ₀ →
    ∃ C,
      ∀ (σ t : ℝ),
        σ₀ ≤ σ →
          σ ≤ 2 →
            0 ≤ t →
              ∀ (N : ℕ),
                1 ≤ N →
                  t ≤ ↑N →
                    ↑σ + ↑t * Complex.I ≠ 1 →
                      ‖riemannZeta (↑σ + ↑t * Complex.I) - BLClosure.S N (↑σ + ↑t * Complex.I) -
                            ↑N ^ (1 - (↑σ + ↑t * Complex.I)) / (↑σ + ↑t * Complex.I - 1)‖ ≤
                        C * ↑N ^ (-σ)
@BLClosure.zeta_approx_sharp_segment : ∀ {σ₁ : ℝ},
  1 / 2 < σ₁ →
    ∃ C,
      ∀ (σ : ℝ),
        σ₁ ≤ σ →
          σ ≤ 2 →
            ∀ (T : ℝ),
              2 ≤ T →
                ∀ t ∈ Set.Icc 1 T,
                  ‖riemannZeta (↑σ + ↑t * Complex.I) - BLClosure.S ⌈T⌉₊ (↑σ + ↑t * Complex.I) -
                        ↑⌈T⌉₊ ^ (1 - (↑σ + ↑t * Complex.I)) / (↑σ + ↑t * Complex.I - 1)‖ ≤
                    C * ↑⌈T⌉₊ ^ (-σ)
@BLClosure.zeta_approx_sharp_segment' : ∀ {σ₁ : ℝ},
  1 / 2 < σ₁ →
    ∃ C,
      0 ≤ C ∧
        ∀ (σ : ℝ),
          σ₁ ≤ σ →
            σ ≤ 2 →
              ∀ (T : ℝ),
                2 ≤ T →
                  ∀ t ∈ Set.Icc 1 T,
                    ‖riemannZeta (↑σ + ↑t * Complex.I) - BLClosure.S ⌈T⌉₊ (↑σ + ↑t * Complex.I) -
                          ↑⌈T⌉₊ ^ (1 - (↑σ + ↑t * Complex.I)) / (↑σ + ↑t * Complex.I - 1)‖ ≤
                      C
BLClosure.S_eq_Dpoly : ∀ (σ : ℝ) (N : ℕ) (t : ℝ), BLClosure.S N (↑σ + ↑t * Complex.I) = Zeta23.BL.M3.Dpoly σ N t
@BLClosure.norm_main_term_le : ∀ {σ₁ σ t : ℝ},
  σ₁ ≤ σ → 0 < t → ∀ {N : ℕ}, 1 ≤ N → ‖↑N ^ (1 - (↑σ + ↑t * Complex.I)) / (↑σ + ↑t * Complex.I - 1)‖ ≤ ↑N ^ (1 - σ₁) / t
@BLClosure.norm_zeta_sq_le_sharp : ∀ {σ₁ σ t C : ℝ},
  σ₁ ≤ σ →
    1 ≤ t →
      ∀ {N : ℕ},
        1 ≤ N →
          ‖riemannZeta (↑σ + ↑t * Complex.I) - BLClosure.S N (↑σ + ↑t * Complex.I) -
                  ↑N ^ (1 - (↑σ + ↑t * Complex.I)) / (↑σ + ↑t * Complex.I - 1)‖ ≤
              C →
            ‖riemannZeta (↑σ + ↑t * Complex.I)‖ ^ 2 ≤
              4 * ‖Zeta23.BL.M3.Dpoly σ N t‖ ^ 2 + 4 * ↑N ^ (2 - 2 * σ₁) * (t ^ 2)⁻¹ + 4 * C ^ 2
@BLClosure.meanSquare_sharp_param : ∀ {σ₁ : ℝ},
  1 / 2 < σ₁ →
    σ₁ < 1 →
      ∃ C,
        ∀ (σ : ℝ),
          σ₁ ≤ σ → σ ≤ 2 → ∀ (T : ℝ), 2 ≤ T → ∫ (t : ℝ) in 1..T, ‖riemannZeta (↑σ + ↑t * Complex.I)‖ ^ 2 ≤ C * T
@BLClosure.meanSquareUnif_all_of_lt_one : ∀ {σ₁ : ℝ},
  1 / 2 < σ₁ →
    σ₁ < 1 →
      ∃ C, ∀ (σ : ℝ), σ₁ ≤ σ → ∀ (T : ℝ), 2 ≤ T → ∫ (t : ℝ) in 1..T, ‖riemannZeta (↑σ + ↑t * Complex.I)‖ ^ 2 ≤ C * T
@BLClosure.meanSquareUnif_all : ∀ {σ₁ : ℝ},
  1 / 2 < σ₁ →
    ∃ C, ∀ (σ : ℝ), σ₁ ≤ σ → ∀ (T : ℝ), 2 ≤ T → ∫ (t : ℝ) in 1..T, ‖riemannZeta (↑σ + ↑t * Complex.I)‖ ^ 2 ≤ C * T
@BLClosure.meanSquareUnifFrom_all : ∀ {σ₁ : ℝ}, 1 / 2 < σ₁ → Zeta23.BL.M3.MeanSquareUnifFrom σ₁
BLClosure.rightHalfBound : Zeta23.BL.RightHalfBound
BLClosure.bohrLandau_all : MNF.RH.BohrLandau
Zeta23.BL.rightHalf_all : ∀ (δ : ℝ), 0 < δ → ∃ C, ∀ (T : ℝ), 2 ≤ T → ↑(Zeta23.BL.NRight δ T) ≤ C * T
Zeta23.BL.rightHalfBound : Zeta23.BL.RightHalfBound
Zeta23.BL.bohrLandau_full : MNF.RH.BohrLandau
Zeta23.BL.rightHalfBound_of_meanSquare' : Zeta23.BL.ZetaMeanSquare → Zeta23.BL.RightHalfBound
@Zeta23.BL.meanSquare_strip' : ∀ {σ : ℝ},
  1 / 2 < σ → σ ≤ 1 → ∃ C, ∀ (T : ℝ), 2 ≤ T → ∫ (t : ℝ) in 0..T, ‖riemannZeta (↑σ + ↑t * Complex.I)‖ ^ 2 ≤ C * T
MNF.RH.reservoirDensityOne_unconditional : MNF.RH.ReservoirDensityOne
@MNF.RH.onLineDensityOne_of_gap_only : ∀ {Δ : ℝ}, 0 < Δ → MNF.RH.SpectralGapHyp Δ → MNF.RH.OnLineDensityOne
