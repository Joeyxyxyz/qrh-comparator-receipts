# Pinned inputs for the independent Comparator run of OpenAI's 7/8 theorem.
# The scripts check what they download against this file. Not pinned here, and why: the Go
# release and landrun's Go modules (the go command verifies them against Go's checksum database);
# Mathlib's prebuilt cache (recorded by digest in the receipt, not known in advance).
# Do not edit: a changed pin means a different experiment, and the receipt would no longer
# describe this one.

# --- the artifact under test ------------------------------------------------------------------
OAI_REPO="https://github.com/openai/math"
OAI_COMMIT="adc7f1241b42e322a6451854ab7e4b4c146bf78a"      # "Initial commit", 2026-10-06
OAI_TOOLCHAIN="leanprover/lean4:v4.34.1"
OAI_SOLUTION_MODULE="OAI.NumberTheory.DirichletL.Nonvanishing"
OAI_THEOREM="OAI.riemannZeta_ne_zero_of_seven_eighths_lt_re"
OAI_CONFIG="ComparatorChallenges/QuasiRiemannHypothesis.json"
OAI_CONFIG_DIRICHLET="ComparatorChallenges/DirichletSevenEighths.json"   # optional second run, same solution module

# git tree object of lean/OAI/NumberTheory/DirichletL at OAI_COMMIT (2,926 files; the proof's
# import closure is 2,924 of them, 486,490 lines, and nothing outside this directory)
OAI_TREE_DIRICHLETL="1e340710a6e6220842ad878bb89a1de4b1989af4"

# sha256 of the files the check trusts or that define the experiment (paths relative to lean/)
SHA_CHALLENGE_LEAN="065f8c9a01d28db78c8b1bfc5083b535082a2d2aac2230d563f98b8caa812cc5"   # ComparatorChallenges/QuasiRiemannHypothesis.lean
SHA_CHALLENGE_JSON="46ebb7edc11f69536210f502b4bcbd36bbaf3f0872c16748b6c8ce43991bf320"   # ComparatorChallenges/QuasiRiemannHypothesis.json
SHA_CHALLENGE_DIRICHLET_LEAN="8fb13ad977bca104591fcbc6ef01a58496e7385053c9b1445f95749afc0eff54"
SHA_CHALLENGE_DIRICHLET_JSON="cfc8d85d49ec5f180e75990d95c59c45f9bd5b9f453a101308870b9c4df9e1d9"
SHA_LAKEFILE="4cca977ebece444b6c999d99755c1ad3c93119bafc127ea761f7f703c7279e74"         # lakefile.lean
SHA_MANIFEST="cf6105a25d9dca2f166b241d9191bd12c7e13305890dc9c4d0952351cccc0794"         # lake-manifest.json
SHA_TOOLCHAIN_FILE="d5edba4e4b8faad9c1baeadb265716d20d03be4d1a2647dc5e35b0c0325bea7b"   # lean-toolchain
SHA_PATCH_PNT="0890432340c0025973bcfe070b634355fa366cc831595f68526e4c73c8903d82"        # patches/PrimeNumberTheoremAnd-lean4341.patch
SHA_PATCH_RELLICH="0c121d8517dfeadc93ef24fe2deb56beec7cb3998e2552dee8f61c780b1408c8"    # patches/rellich-kondrachov-lean4341.patch
SHA_SOLUTION_ENTRY="d98c4a7e074469b429890e1c21b8cc76c410026525a776895293cdc0f9e6ae89"   # OAI/NumberTheory/DirichletL/Nonvanishing.lean

# The proof's own source files, measured with scripts/closure_scan.py at OAI_COMMIT: the entry
# module and every project file it imports, directly or not. CLOSURE_DIGEST is a sha256 over the
# sorted list of (module name, sha256 of the file). The scan found none of: sorry, axiom,
# native_decide, set_option, unsafe/implemented_by/extern, macro/elab/syntax, run_cmd, #eval.
CLOSURE_MODULES="2924"
CLOSURE_LINES="486490"
CLOSURE_DIGEST="addafd4ade85bf198b6022924b1d8198c0f7cd7e596bec0bb695e02288059045"

# The only files outside Mathlib and Lean that the proof imports, measured the same way AFTER
# OpenAI's compatibility patches are applied (same scan, same result: nothing flagged).
PNT_ENTRY="PrimeNumberTheoremAnd.Wiener"
PNT_CLOSURE_MODULES="4"
PNT_CLOSURE_LINES="2561"
PNT_CLOSURE_DIGEST="9657a1c147049c200d1c5526c493b38ee0c072d3da4f48a405555517e4a06b78"
RELLICH_ENTRY="RellichKondrachov.Analysis.FunctionalSpaces.Sobolev.Euclidean.Rellich"
RELLICH_CLOSURE_MODULES="15"
RELLICH_CLOSURE_LINES="3993"
RELLICH_CLOSURE_DIGEST="7d48880d660e292ad97e5d80bf3439f0187ea1556a9e5ad3cfa8ceb8fbb8673f"

# Lake configuration files are code that Lake runs when it loads the workspace. After `lake update`
# the 42 dependency packages have one each (32 declarative lakefile.toml, 10 lakefile.lean). The
# ten Lean ones contain no run_cmd, and only Mathlib's has a post_update hook (its cache download).
# DEPS_LAKEFILES_DIGEST is the sha256 of the sorted `sha256sum` listing of those 42 files.
DEPS_LAKEFILES_COUNT="42"
DEPS_LAKEFILES_DIGEST="20c662a7350194f61c90db455a0833b2a6d4035015afdf47fdcc42c5a8e37204"

# dependency commits the proof's import closure actually uses (from OpenAI's lakefile/manifest)
MATHLIB_COMMIT="d13f23b723b8a846827a245b89c10fc7d3f11612"
PNT_COMMIT="c39a751132c88b6e8080b74c74023fd95b3d8be0"          # AlexKontorovich/PrimeNumberTheoremAnd (+ OpenAI patch)
RELLICH_COMMIT="70f85d4c1bf99c6e7d61e8be4daa6f3664d08d23"      # abenenson/rellich-kondrachov (+ OpenAI patch)

# --- the checker ------------------------------------------------------------------------------
# There is no Comparator or lean4export release for Lean 4.34.1. The v4.34.0 release of each is
# used, built with the 4.34.1 toolchain (lean4export must be built by the same Lean that wrote the
# .olean files it reads). Comparator's source at v4.34.0 is identical to its v4.35.0-rc4 head
# apart from the toolchain pin and the dependency manifest. Tested 2026-10-07: built this way,
# Comparator gives the expected outcome on the sixteen projects of its own regression suite that
# do not need the nanoda kernel (controls/upstream_expected.tsv).
COMPARATOR_REPO="https://github.com/leanprover/comparator"
COMPARATOR_TAG="v4.34.0"
COMPARATOR_COMMIT="d03acab154d269c06e60e4de7e4cc85deebff94b"
LEAN4EXPORT_COMMIT="076e8e57707e813375e8f9da8bf989799ace9680"   # pinned by Comparator's own manifest at that tag
LANDRUN_MODULE="github.com/zouuup/landrun/cmd/landrun"
LANDRUN_COMMIT="811cfff51ceaf3d9843708aa6d22e9b84ccac8b4"       # landrun 0.1.18, head of main on 2026-10-07

# Go is only used to build landrun. The go command of the distribution fetches exactly this
# release and verifies it, and landrun's modules, against Go's public checksum database.
GO_VERSION="1.24.7"                                             # landrun's go.mod needs >= 1.24

# elan (the Lean version manager), from a pinned release archive
ELAN_VERSION="v4.2.4"
ELAN_SHA256_X86_64="42b94d4244e8353142c456ec0e4ca6528fd898a6c604d4059f494e706e431f63"
ELAN_SHA256_AARCH64="05febd124d84ebf994b2e7479922a5650b1e950c17ae3bd1ddd776b65bb72bf9"

# The Lean toolchain itself (x86_64 Linux release of v4.34.1): the kernel that judges the proof
# is in these files. sha256 taken from the official release archive on 2026-10-06.
SHA_LEAN_BIN_LEAN="e8baaa71855a616dc351028f3ad2200051b0671f423a1696a100e809302d5550"
SHA_LEAN_BIN_LAKE="6f53827dab18010d6c690d14c8401cacabc1db958edb3552a877ed4cf1dd995d"
SHA_LEAN_LIBLEANSHARED="6b30cc963d065fc9d2f87f7e9cbe0682b23000ae5425bccd769c5d477fa74f13"
SHA_LEAN_LIBLEANSHARED_1="69e900c025f40bf05c14f5b9ec48071b3130e34c96a7c45ee2eb5b6f307e19e6"
SHA_LEAN_LIBLEANSHARED_2="38d0a03750b2e8d51161885ad597a8b4f6d3b85215c5a52aecd2b3753273cf3f"
SHA_LEAN_LIBINIT_SHARED="07f8c1156271ab6ec36c14c3031b5572329325d5f73dde3e89a1615d88f4e5cb"
SHA_LEAN_LIBLAKE_SHARED="ef0eb8942cd68ffb61ae573850a7181f70860580959e296c6e1a0e31ec50a38a"

# --- the controls ------------------------------------------------------------------------------
# Phase 3 must see exactly this many control projects accepted and rejected: the kit's five
# (controls/: 2 to accept, 3 to reject) and the sixteen of Comparator's own suite that do not
# need the nanoda kernel (4 to accept, 12 to reject; controls/upstream_expected.tsv).
CONTROLS_ACCEPT="6"
CONTROLS_REJECT="15"

# --- the bridge (phase 8) -----------------------------------------------------------------------
# The two Lean files of bridge/, and the statements Lean printed for the second one when the kit
# was written. Compiled 2026-10-07 with the Lean and Mathlib versions above; the second file
# against a stand-in for OpenAI's theorem, because the real proof was not built on that machine.
SHA_BRIDGE_COND="52e1a646e36e070c459b6236b10c8af244add926114c584610b9a3a96821842c"
SHA_BRIDGE_UNCOND="e63101cc7543d9d51b6b43db8f93c240b1c84903b961afc8c0a7827adc15584c"
SHA_BRIDGE_EXPECTED="346eac772016fef9551fa9509e06fba8e2867f670cd76e557df9791ffeeb584d"
