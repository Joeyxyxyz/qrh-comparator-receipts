# Pinned inputs for the independent Comparator run of Anthropic's zeta23 formalization
# (anthropics/formal-math, zeta23/: Alpöge–Furman, "More than two thirds of the zeta zeros are
# simple and on the critical line", arXiv:2608.13637). Read 2026-10-28 on Joey's laptop.
# Do not edit: a changed pin means a different experiment, and the receipt would no longer
# describe this one.

# --- the artifact under test ------------------------------------------------------------------
FM_REPO="https://github.com/anthropics/formal-math"
FM_COMMIT="16a5ce41304fcdaea4e0be7c132e1c361dc26da5"          # main on 2026-10-27; zeta23/ last changed at 2bafb8c8 (2026-08-28)
Z23_SUBDIR="zeta23"
Z23_TOOLCHAIN="leanprover/lean4:v4.33.0-rc2"
Z23_MATHLIB_COMMIT="51e6992efd06126df61a496bebf8f49482a4e129"   # lake-manifest.json of zeta23
Z23_CONFIG="comparator.json"                                     # 17 theorem names, no definition holes, enable_nanoda true
Z23_CONFIG_XIPRIME="comparator-xiprime.json"                     # the second topic (6 statements); not run by this add-on
Z23_THEOREM_COUNT="17"
Z23_CHALLENGE_MODULE="Challenge"
Z23_SOLUTION_MODULE="Solution"

# sha256 of the trusted files (the statement surface and the build configuration), paths
# relative to zeta23/. Challenge.lean inlines ChallengeDeps.lean's definitions and imports only
# Mathlib; Solution.lean is the untrusted side.
SHA_Z23_CHALLENGE="6f2a4ba95ab8c5319e541a1cc1b3699c0ae8cef23ea8e68f958e11b07281761e"            # Challenge.lean
SHA_Z23_CHALLENGEDEPS="8f9a7e7bb313bbada77d0dd1b71a80bda1c0580b71ba1dd0020b438d63a318e0"        # ChallengeDeps.lean
SHA_Z23_CONFIG="610d95c6c84f13b3e2238b476fe45f0b28567108f536f67a0b9ed1586a2c68f1"               # comparator.json
SHA_Z23_CONFIG_XIPRIME="ae449af0b33ed20482ddd9405dacdab061d4826b08765f4555f14d5062f5feff"       # comparator-xiprime.json
SHA_Z23_LAKEFILE="4942f994b9250b1efacea071fd997b0395960d61f30f5f79e21f4d2870265288"             # lakefile.toml
SHA_Z23_MANIFEST="1847b362e15efd927e75aa8b5442e491f998e4a3f730f9dcaca9841f2957c448"             # lake-manifest.json
SHA_Z23_TOOLCHAIN_FILE="0d3c76ccd8772d8bcbe207241421a760312b71a6aa82f84194391fdf5cb026d6"       # lean-toolchain
SHA_Z23_CHALLENGE_XIPRIME="bdc9e83074a0638c88b6768c55305bb4d7da8267bfed3cc0449edcc7c8fa2dfc"    # Challenge/XiPrime.lean
SHA_Z23_CHALLENGEDEPS_XIPRIME="28ff423aecf77b32e81dbca6a4ea57edd0d3d07aff599e4874c9f3a8f4d0ef7b" # ChallengeDeps/XiPrime.lean

# --- the checker, at the tags that match the project's toolchain ------------------------------
# Comparator and lean4export both have a v4.33.0-rc2 release whose own lean-toolchain is
# v4.33.0-rc2, so, unlike the main kit, nothing is built with a toolchain other than its own.
# Comparator's manifest at this tag pins exactly this lean4export commit.
Z23_COMPARATOR_REPO="https://github.com/leanprover/comparator"
Z23_COMPARATOR_TAG="v4.33.0-rc2"
Z23_COMPARATOR_COMMIT="75c730e9b6ef5c2c3b334fad7c3d51fe20624c88"
