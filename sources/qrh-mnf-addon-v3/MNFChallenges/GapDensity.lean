/-
MNF × RIEMANN ZETA — COMPARATOR CHALLENGE  (MNFChallenges/GapDensity.lean)
Mirror of MNF/RH/GapDensity.lean: its Mathlib imports and preamble, its definitions and structures copied verbatim
and in order, and every theorem of MNFChallenges/theorem_list.txt with the proof replaced by
`sorry`.  Generated by scripts/gen_challenge.py; the challenge is MNFChallenges.RH, which imports
the other mirror modules.  Comparator builds the challenge and the solution (MNF.RH.Unconditional),
exports both, and checks that every theorem statement and every definition (name, type and body:
`definition_names` is empty, so nothing is a hole) agrees, and that the solution's proofs use no
axiom beyond propext, Quot.sound, Classical.choice.
-/
import MNFChallenges.Counting

namespace MNF.RH
open Complex Set
open scoped BigOperators

noncomputable def N0 (T₁ T₂ : ℝ) : ℕ := ∑ᶠ ρ ∈ zerosIn T₁ T₂ ∩ {ρ | ρ.re = 1 / 2}, zeta_order ρ

noncomputable def NOff (δ T₁ T₂ : ℝ) : ℕ := ∑ᶠ ρ ∈ zerosIn T₁ T₂ ∩ {ρ | δ ≤ |ρ.re - 1 / 2|}, zeta_order ρ

def BohrLandau : Prop := ∀ δ : ℝ, 0 < δ → ∃ C : ℝ, ∀ T : ℝ, 2 ≤ T → (NOff δ 0 T : ℝ) ≤ C * T

def NcountSuperlinear : Prop := ∀ c : ℝ, 0 < c → ∃ T₀ : ℝ, ∀ T ≥ T₀, c * T ≤ (Ncount 0 T : ℝ)

theorem N0_le_Ncount (T₁ T₂ : ℝ) : N0 T₁ T₂ ≤ Ncount T₁ T₂ := by
  sorry

theorem NOff_le_Ncount (δ T₁ T₂ : ℝ) : NOff δ T₁ T₂ ≤ Ncount T₁ T₂ := by
  sorry

theorem gap_forces_NOff_eq {Δ : ℝ} (hΔ : 0 < Δ) (hgap : SpectralGapHyp Δ) (T₁ T₂ : ℝ) :
    Ncount T₁ T₂ = N0 T₁ T₂ + NOff Δ T₁ T₂ := by
  sorry

theorem on_line_density_one_of_gap (hBL : BohrLandau) (hN : NcountSuperlinear) {Δ : ℝ}
    (hΔ : 0 < Δ) (hgap : SpectralGapHyp Δ) :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀, (1 - ε) * (Ncount 0 T : ℝ) ≤ N0 0 T := by
  sorry

end MNF.RH
